PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgresql://chatapp_user:choose_a_password@localhost:5432/chatapp

# Long random string - generate with: openssl rand -hex 32
JWT_SECRET=

# The GitHub Pages URL your frontend will be served from
CORS_ORIGIN=https://yourusername.github.io

# Filled in during the voice chat phase (Cloudflare Realtime) - leave blank for now
CF_ACCOUNT_ID=
CF_REALTIME_APP_ID=
CF_REALTIME_APP_TOKEN=
