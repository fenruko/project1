PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgresql://chatapp_user:choose_a_password@localhost:5432/chatapp

# Long random string - generate with: openssl rand -hex 32
JWT_SECRET=

# The GitHub Pages URL your frontend will be served from
CORS_ORIGIN=https://yourusername.github.io

# Filled in during the voice chat phase (Cloudflare Realtime) - leave blank for now
CF_ACCOUNT_ID=
CF_REALTIME_APP_ID=
CF_REALTIME_APP_TOKEN=

# LiveKit Cloud (voice chat)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Backblaze B2 (direct browser-to-storage uploads, no credit card required)
# S3-compatible - bucket stays PRIVATE (avoids B2's card-requiring public-bucket fee).
# Downloads use short-lived signed URLs generated by the backend instead.
B2_REGION=
B2_ENDPOINT=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
